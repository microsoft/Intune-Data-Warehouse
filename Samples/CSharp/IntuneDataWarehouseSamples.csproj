<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      To build for legacy Windows-only hosts, swap the TargetFramework above
      for <TargetFramework>net48</TargetFramework>. Microsoft.Identity.Client
      supports both.
    -->
    <RootNamespace>IntuneDataWarehouseSamples</RootNamespace>
    <AssemblyName>IntuneDataWarehouseSamples</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
  </ItemGroup>

</Project>
